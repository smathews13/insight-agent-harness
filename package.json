{
  "name": "insight-agent-harness-workspace",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/contracts",
    "packages/governance",
    "packages/observability",
    "packages/lakebase",
    "packages/export-core",
    "packages/slack-boundary"
  ],
  "scripts": {
    "contracts:generate": "npm --workspace @insight-agent-harness/contracts run generate",
    "contracts:check": "npm --workspace @insight-agent-harness/contracts run check",
    "contracts:test": "npm --workspace @insight-agent-harness/contracts test",
    "packages:test": "npm test --workspaces --if-present",
    "packages:check": "npm run check --workspaces --if-present",
    "packages:pack:check": "node scripts/check_package_builds.mjs",
    "packages:integrity": "python3 scripts/package_integrity.py package-check",
    "packages:sources": "python3 scripts/check-package-sources.py",
    "packages:sbom:test": "python3 -m unittest scripts.tests.test_package_integrity",
    "boundary:ownership": "python3 scripts/check-ownership-boundary.py",
    "boundary:neutral": "python3 scripts/check-neutral-surface.py",
    "runtime-py:test": "PYTHONPATH=packages/contracts/src:packages/agent-runtime-py/src python3 -m unittest discover -s packages/agent-runtime-py/tests -p 'test_*.py' -v",
    "external-intelligence-py:test": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s packages/external-intelligence-py/tests -p 'test_*.py' -v",
    "runtime-py:wheel": "python3 scripts/check_runtime_wheel.py",
    "shared:test": "npm run packages:test && npm run runtime-py:test && npm run external-intelligence-py:test",
    "shared:check": "npm run packages:check && npm run packages:pack:check && npm run packages:sbom:test && npm run packages:integrity"
  }
}
