{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insight-agent-harness.local/schemas/release-manifest.schema.json",
  "title": "ReleaseManifest",
  "description": "Closed, signed identity and compatibility contract for one promoted app/model release.",
  "type": "object",
  "required": [
    "schema_version",
    "manifest_id",
    "manifest_content_sha256",
    "release_id",
    "source_commit",
    "release_source_sha256",
    "app_source_sha256",
    "model_source_sha256",
    "upstream_tag",
    "upstream_sha",
    "upstream_artifact_sha256",
    "upstream_attestation",
    "app_artifact_sha256",
    "model_artifact_sha256",
    "registered_model",
    "prompt_pack_sha256",
    "policy_version",
    "product_manifest_sha256",
    "shared_packages",
    "artifact_contract",
    "lakebase",
    "authorization",
    "data_boundary_fingerprint",
    "genie_curation_fingerprints",
    "enabled_capability_mcp_fingerprint",
    "evaluation",
    "controls",
    "deploy_artifact_sha256",
    "resource_bindings_fingerprint",
    "observations",
    "signer_key_id",
    "signed_at",
    "approval_record_id",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "manifest_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-8[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "manifest_content_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "release_id": {
      "type": "object",
      "required": [
        "product",
        "upstream",
        "overlay",
        "app_artifact",
        "model_artifact"
      ],
      "properties": {
        "product": {
          "$ref": "#/$defs/releaseIdentity"
        },
        "upstream": {
          "$ref": "#/$defs/releaseIdentity"
        },
        "overlay": {
          "$ref": "#/$defs/releaseIdentity"
        },
        "app_artifact": {
          "$ref": "#/$defs/releaseIdentity"
        },
        "model_artifact": {
          "$ref": "#/$defs/releaseIdentity"
        }
      },
      "additionalProperties": false
    },
    "source_commit": {
      "$ref": "#/$defs/fullCommit"
    },
    "release_source_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "app_source_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "model_source_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "upstream_tag": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!latest$)(?!refs/heads/)(?!heads/)(?![0-9a-f]{7,39}$)[A-Za-z0-9][A-Za-z0-9._/+:-]{0,127}$"
    },
    "upstream_sha": {
      "$ref": "#/$defs/fullCommit"
    },
    "upstream_artifact_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "upstream_attestation": {
      "type": "object",
      "required": ["status", "verifier"],
      "properties": {
        "status": {
          "enum": ["verified", "unverified", "not_available"]
        },
        "verifier": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{1,63}$"
        },
        "evidence_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "app_artifact_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "model_artifact_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "registered_model": {
      "type": "object",
      "required": ["version", "ref_sha256"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "ref_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "prompt_pack_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "policy_version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "product_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "shared_packages": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["name", "version", "artifact_sha256"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^(?:@[a-z0-9_.-]+/)?[a-z0-9][a-z0-9_.-]{0,127}$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "artifact_sha256": {
            "$ref": "#/$defs/sha256"
          }
        },
        "additionalProperties": false
      }
    },
    "artifact_contract": {
      "type": "object",
      "required": [
        "canonical_schema_version",
        "export_adapter_version",
        "supported_formats",
        "binary_adapters"
      ],
      "properties": {
        "canonical_schema_version": {
          "const": "1.1.0"
        },
        "export_adapter_version": {
          "const": "1.2.0"
        },
        "supported_formats": {
          "type": "array",
          "minItems": 4,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": ["csv", "html", "json", "markdown", "pdf", "png", "tsv", "xlsx"]
          }
        },
        "binary_adapters": {
          "type": "object",
          "required": ["pdf", "png", "pptx", "xlsx"],
          "properties": {
            "pdf": { "enum": ["available", "unavailable"] },
            "png": { "enum": ["available", "unavailable"] },
            "pptx": { "enum": ["available", "unavailable"] },
            "xlsx": { "enum": ["available", "unavailable"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "lakebase": {
      "type": "object",
      "required": ["migration_version", "rollback_floor"],
      "properties": {
        "migration_version": {
          "type": "integer",
          "minimum": 1
        },
        "rollback_floor": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "required": ["auth_mode", "oauth_scopes"],
      "properties": {
        "auth_mode": {
          "enum": ["user_authorization", "explicit_service_principal"]
        },
        "oauth_scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]*(?::[a-z][a-z0-9._-]*)?$"
          }
        }
      },
      "additionalProperties": false
    },
    "data_boundary_fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "genie_curation_fingerprints": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["role", "sha256"],
        "properties": {
          "role": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{1,63}$"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        },
        "additionalProperties": false
      }
    },
    "enabled_capability_mcp_fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "evaluation": {
      "type": "object",
      "required": [
        "suite_version",
        "dataset_version",
        "scorer_versions",
        "gate_result_digests"
      ],
      "properties": {
        "suite_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "dataset_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "scorer_versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/versionedDigest"
          }
        },
        "gate_result_digests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/namedDigest"
          }
        }
      },
      "additionalProperties": false
    },
    "controls": {
      "type": "object",
      "required": [
        "audit_schema_version",
        "audit_policy_ref",
        "retention_policy_ref",
        "budget_policy_ref",
        "budget_mode",
        "reservation_mode"
      ],
      "properties": {
        "audit_schema_version": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
        },
        "audit_policy_ref": {
          "type": "string",
          "pattern": "^policy:[a-z0-9][a-z0-9._-]{1,127}$"
        },
        "retention_policy_ref": {
          "type": "string",
          "pattern": "^policy:[a-z0-9][a-z0-9._-]{1,127}$"
        },
        "budget_policy_ref": {
          "type": "string",
          "pattern": "^policy:[a-z0-9][a-z0-9._-]{1,127}$"
        },
        "budget_mode": {
          "enum": ["reporting_only", "enforced"]
        },
        "reservation_mode": {
          "enum": ["none", "atomic_expected_maximum"]
        }
      },
      "additionalProperties": false
    },
    "deploy_artifact_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "resource_bindings_fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": {
            "enum": [
              "source_commit",
              "release_source",
              "app_source",
              "model_source",
              "upstream_pin",
              "app_artifact",
              "model_artifact",
              "registered_model",
              "product_manifest",
              "authorization",
              "lakebase_migration",
              "data_boundary",
              "genie_curation",
              "shared_packages",
              "artifact_schema",
              "export_adapters",
              "capabilities",
              "evaluation_gate",
              "audit_schema",
              "retention_policy",
              "budget_policy",
              "deploy_artifact"
            ]
          },
          "status": {
            "enum": ["verified", "unverified", "failed"]
          },
          "observed_sha256": {
            "$ref": "#/$defs/sha256"
          }
        },
        "additionalProperties": false
      }
    },
    "signer_key_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{2,63}$"
    },
    "signed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"
    },
    "approval_record_id": {
      "type": "string",
      "pattern": "^approval:sha256:[0-9a-f]{64}$"
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fullCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "releaseIdentity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/+:-]{0,159}$"
    },
    "namedDigest": {
      "type": "object",
      "required": ["name", "sha256"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{1,63}$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "versionedDigest": {
      "type": "object",
      "required": ["name", "version", "sha256"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{1,63}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
