{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insight-agent-harness.local/schemas/release-key-registry.schema.json",
  "title": "ReleaseKeyRegistry",
  "description": "Public release-signing keys. Private key material is never valid in this contract.",
  "type": "object",
  "required": ["schema_version", "keys"],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "keys": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["key_id", "algorithm", "public_key_pem", "status"],
        "properties": {
          "key_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{2,63}$"
          },
          "algorithm": {
            "const": "Ed25519"
          },
          "public_key_pem": {
            "type": "string",
            "pattern": "^-----BEGIN PUBLIC KEY-----\\n[A-Za-z0-9+/=\\n]+\\n-----END PUBLIC KEY-----\\n?$"
          },
          "status": {
            "enum": ["active", "retired", "revoked"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
