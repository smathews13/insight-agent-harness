{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insight-agent-harness.local/schemas/product-manifest.schema.json",
  "title": "ProductManifest",
  "description": "A closed, privileged product declaration. Unknown fields are rejected at every level.",
  "type": "object",
  "required": [
    "schema_version",
    "product",
    "presentation",
    "extensions",
    "capabilities",
    "knowledge",
    "tools",
    "genie",
    "resources",
    "settings",
    "authorization",
    "collaboration",
    "data_boundary",
    "operations",
    "exports",
    "compatibility"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "product": {
      "type": "object",
      "x-risk-class": "presentation",
      "x-runtime-editable": false,
      "required": ["id", "display_name", "version", "description"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "version": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "additionalProperties": false
    },
    "presentation": {
      "type": "object",
      "x-risk-class": "presentation",
      "x-runtime-editable": true,
      "required": ["title", "theme"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "theme": {
          "enum": ["light", "dark", "system"]
        },
        "icon_uri": {
          "type": "string",
          "maxLength": 320,
          "anyOf": [
            {
              "pattern": "^asset://[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
            },
            {
              "pattern": "^reference:[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "description": "Allowlisted, data-only product extension slots. References are materialized by downstream tooling; they are never import paths.",
      "x-risk-class": "behavioral",
      "x-runtime-editable": false,
      "required": [
        "branding",
        "navigation",
        "loading",
        "prompts",
        "knowledge",
        "tool_registry",
        "genie_mode",
        "resources",
        "migrations",
        "settings",
        "export_chrome"
      ],
      "properties": {
        "branding": {
          "type": "string",
          "pattern": "^extension:branding/[a-z][a-z0-9._/-]{1,255}$"
        },
        "navigation": {
          "type": "string",
          "pattern": "^extension:navigation/[a-z][a-z0-9._/-]{1,255}$"
        },
        "loading": {
          "type": "string",
          "pattern": "^extension:loading/[a-z][a-z0-9._/-]{1,255}$"
        },
        "prompts": {
          "type": "string",
          "pattern": "^extension:prompts/[a-z][a-z0-9._/-]{1,255}$"
        },
        "knowledge": {
          "type": "string",
          "pattern": "^extension:knowledge/[a-z][a-z0-9._/-]{1,255}$"
        },
        "tool_registry": {
          "type": "string",
          "pattern": "^extension:tools/[a-z][a-z0-9._/-]{1,255}$"
        },
        "genie_mode": {
          "type": "string",
          "pattern": "^extension:genie/[a-z][a-z0-9._/-]{1,255}$"
        },
        "resources": {
          "type": "string",
          "pattern": "^extension:resources/[a-z][a-z0-9._/-]{1,255}$"
        },
        "migrations": {
          "type": "string",
          "pattern": "^extension:migrations/[a-z][a-z0-9._/-]{1,255}$"
        },
        "settings": {
          "type": "string",
          "pattern": "^extension:settings/[a-z][a-z0-9._/-]{1,255}$"
        },
        "export_chrome": {
          "type": "string",
          "pattern": "^extension:export/[a-z][a-z0-9._/-]{1,255}$"
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "x-risk-class": "governed_capability",
      "x-runtime-editable": false,
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["id", "kind", "enabled", "dependencies"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{1,63}$"
              },
              "kind": {
                "enum": [
                  "answer",
                  "genie_query",
                  "evidence_tool",
                  "agent_sql",
                  "export"
                ]
              },
              "enabled": {
                "type": "boolean"
              },
              "dependencies": {
                "type": "array",
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]{1,63}$"
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "knowledge": {
      "type": "object",
      "x-risk-class": "behavioral",
      "x-runtime-editable": false,
      "required": ["source_refs"],
      "properties": {
        "source_refs": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 320,
            "pattern": "^[a-z][a-z0-9_.-]{1,63}:[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
          }
        },
        "prompt_pack_refs": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^prompt:[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
          }
        }
      },
      "additionalProperties": false
    },
    "tools": {
      "type": "object",
      "x-risk-class": "governed_capability",
      "x-runtime-editable": false,
      "required": ["registry_refs", "enabled_tool_ids"],
      "properties": {
        "registry_refs": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^tool-registry:[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
          }
        },
        "enabled_tool_ids": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{1,63}$"
          }
        }
      },
      "additionalProperties": false
    },
    "genie": {
      "type": "object",
      "x-risk-class": "behavioral",
      "x-runtime-editable": false,
      "required": [
        "mode",
        "allow_agent_authored_sql",
        "space_refs",
        "required_space_roles"
      ],
      "properties": {
        "mode": {
          "enum": ["genie_only", "hybrid", "disabled"]
        },
        "allow_agent_authored_sql": {
          "type": "boolean"
        },
        "space_refs": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 320,
            "pattern": "^[a-z][a-z0-9_.-]{1,63}:[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
          }
        },
        "required_space_roles": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{1,63}$"
          }
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "x-risk-class": "resource_binding",
      "x-runtime-editable": false,
      "required": ["bindings"],
      "properties": {
        "bindings": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["name", "kind", "ref"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{1,63}$"
              },
              "kind": {
                "enum": [
                  "genie_space",
                  "sql_warehouse",
                  "serving_endpoint",
                  "vector_index",
                  "volume",
                  "experiment",
                  "lakebase_database",
                  "databricks_app",
                  "secret",
                  "unity_catalog_schema",
                  "job"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 3,
                "maxLength": 320,
                "pattern": "^[a-z][a-z0-9_.-]{1,63}:[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
              }
            },
            "additionalProperties": false
          }
        },
        "bundle_target": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{1,63}$"
        },
        "generated_name_prefix": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{1,47}$"
        }
      },
      "additionalProperties": false
    },
    "settings": {
      "type": "object",
      "x-risk-class": "operations",
      "x-runtime-editable": false,
      "required": ["defaults_ref", "runtime_editable_keys"],
      "properties": {
        "defaults_ref": {
          "type": "string",
          "pattern": "^settings:[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
        },
        "runtime_editable_keys": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{1,63}$"
          }
        }
      },
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "x-risk-class": "identity_security",
      "x-runtime-editable": false,
      "required": [
        "default_mode",
        "supported_modes",
        "user_scopes",
        "evidence_tools"
      ],
      "properties": {
        "default_mode": {
          "enum": ["user_authorization", "explicit_service_principal"]
        },
        "supported_modes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": ["user_authorization", "explicit_service_principal"]
          }
        },
        "user_scopes": {
          "type": "array",
          "maxItems": 11,
          "uniqueItems": true,
          "items": {
            "enum": [
              "catalog.catalogs:read",
              "catalog.schemas:read",
              "catalog.tables:read",
              "dashboards.genie",
              "model-serving",
              "postgres",
              "serving.serving-endpoints",
              "sql",
              "vectorsearch.vector-search-endpoints:read",
              "vectorsearch.vector-search-indexes:read",
              "workspace.workspace:read"
            ]
          }
        },
        "evidence_tools": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["capability_id", "auth_mode"],
            "properties": {
              "capability_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{1,63}$"
              },
              "auth_mode": {
                "enum": ["user_authorization", "explicit_service_principal"]
              }
            },
            "additionalProperties": false
          }
        },
        "service_principal_policy_ref": {
          "type": "string",
          "minLength": 3,
          "maxLength": 320,
          "pattern": "^[a-z][a-z0-9_.-]{1,63}:[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
        },
        "answer_label_disclosure_ref": {
          "type": "string",
          "minLength": 3,
          "maxLength": 320,
          "pattern": "^[a-z][a-z0-9_.-]{1,63}:[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
        },
        "service_principal_data_boundary_ref": {
          "type": "string",
          "minLength": 3,
          "maxLength": 320,
          "pattern": "^[a-z][a-z0-9_.-]{1,63}:[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
        },
        "audit_mode": {
          "enum": ["full", "security_relevant"]
        }
      },
      "additionalProperties": false
    },
    "collaboration": {
      "type": "object",
      "x-risk-class": "identity_security",
      "x-runtime-editable": false,
      "required": [
        "team_authority",
        "project_roles",
        "membership_sources",
        "project_context_policy_ref",
        "snapshot_targets"
      ],
      "properties": {
        "team_authority": {
          "const": "account_scim_read_only"
        },
        "project_roles": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "owner",
              "editor",
              "contributor",
              "viewer",
              "auditor"
            ]
          }
        },
        "membership_sources": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "direct_user",
              "account_scim_team"
            ]
          }
        },
        "project_context_policy_ref": {
          "type": "string",
          "minLength": 3,
          "maxLength": 320,
          "pattern": "^[a-z][a-z0-9_.-]{1,63}:[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
        },
        "snapshot_targets": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "run",
              "artifact"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "data_boundary": {
      "type": "object",
      "x-risk-class": "data_boundary",
      "x-runtime-editable": false,
      "required": ["boundary_policy_ref", "permitted_dataset_refs"],
      "properties": {
        "boundary_policy_ref": {
          "type": "string",
          "minLength": 3,
          "maxLength": 320,
          "pattern": "^[a-z][a-z0-9_.-]{1,63}:[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
        },
        "permitted_dataset_refs": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 320,
            "pattern": "^[a-z][a-z0-9_.-]{1,63}:[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
          }
        }
      },
      "additionalProperties": false
    },
    "operations": {
      "type": "object",
      "x-risk-class": "operations",
      "x-runtime-editable": false,
      "required": [
        "readiness_policy",
        "limits",
        "budget",
        "freshness_policy_refs",
        "retention_policy_ref",
        "kill_switch_refs",
        "mcp"
      ],
      "properties": {
        "readiness_policy": {
          "const": "strict_persistent_analytics"
        },
        "limits": {
          "type": "object",
          "required": [
            "max_run_seconds",
            "max_tool_calls",
            "max_steps",
            "max_output_bytes"
          ],
          "properties": {
            "max_run_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 900
            },
            "max_tool_calls": {
              "type": "integer",
              "minimum": 1,
              "maximum": 128
            },
            "max_steps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "max_output_bytes": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 10485760
            }
          },
          "additionalProperties": false
        },
        "budget": {
          "type": "object",
          "required": ["mode", "reporting_policy_ref"],
          "properties": {
            "mode": {
              "enum": ["reporting_only", "enforced"]
            },
            "reporting_policy_ref": {
              "type": "string",
              "minLength": 3,
              "maxLength": 320,
              "pattern": "^[a-z][a-z0-9_.-]{1,63}:[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
            },
            "reservation_policy_ref": {
              "type": "string",
              "minLength": 3,
              "maxLength": 320,
              "pattern": "^[a-z][a-z0-9_.-]{1,63}:[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
            },
            "reconciliation_policy_ref": {
              "type": "string",
              "minLength": 3,
              "maxLength": 320,
              "pattern": "^[a-z][a-z0-9_.-]{1,63}:[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
            }
          },
          "additionalProperties": false
        },
        "freshness_policy_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 320,
            "pattern": "^[a-z][a-z0-9_.-]{1,63}:[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
          }
        },
        "retention_policy_ref": {
          "type": "string",
          "minLength": 3,
          "maxLength": 320,
          "pattern": "^[a-z][a-z0-9_.-]{1,63}:[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
        },
        "kill_switch_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 320,
            "pattern": "^[a-z][a-z0-9_.-]{1,63}:[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
          }
        },
        "mcp": {
          "type": "object",
          "required": ["enabled", "direct_fallback_mode"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "direct_fallback_mode": {
              "enum": ["blocked", "same_user_audited"]
            },
            "registered_adapter_ref": {
              "type": "string",
              "minLength": 3,
              "maxLength": 320,
              "pattern": "^[a-z][a-z0-9_.-]{1,63}:[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
            },
            "destination_policy_ref": {
              "type": "string",
              "minLength": 3,
              "maxLength": 320,
              "pattern": "^[a-z][a-z0-9_.-]{1,63}:[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
            },
            "signing_key_ref": {
              "type": "string",
              "minLength": 3,
              "maxLength": 320,
              "pattern": "^[a-z][a-z0-9_.-]{1,63}:[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
            },
            "kill_switch_ref": {
              "type": "string",
              "minLength": 3,
              "maxLength": 320,
              "pattern": "^[a-z][a-z0-9_.-]{1,63}:[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "exports": {
      "type": "object",
      "x-risk-class": "data_boundary",
      "x-runtime-editable": false,
      "required": ["external_enabled", "formats", "adapter_refs"],
      "properties": {
        "external_enabled": {
          "type": "boolean"
        },
        "formats": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": ["markdown", "html", "pdf", "json", "csv", "tsv", "xlsx", "png"]
          }
        },
        "adapter_refs": {
          "description": "Opaque refs resolved only against export adapters compiled into the product distribution.",
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^export-adapter:[a-z][a-z0-9._/-]{1,255}$"
          }
        },
        "egress_policy_ref": {
          "type": "string",
          "minLength": 3,
          "maxLength": 320,
          "pattern": "^[a-z][a-z0-9_.-]{1,63}:[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
        },
        "redaction_profile_ref": {
          "type": "string",
          "minLength": 3,
          "maxLength": 320,
          "pattern": "^[a-z][a-z0-9_.-]{1,63}:[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
        },
        "chrome_ref": {
          "type": "string",
          "pattern": "^export-chrome:[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
        },
        "document_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "x-risk-class": "identity_security",
      "x-runtime-editable": false,
      "required": ["minimum_platform_version", "registry_ref", "aliases"],
      "properties": {
        "minimum_platform_version": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)$"
        },
        "registry_ref": {
          "type": "string",
          "pattern": "^compatibility:[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
        },
        "aliases": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "alias",
              "target",
              "owner",
              "telemetry_key",
              "removal_version"
            ],
            "properties": {
              "alias": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{1,95}$"
              },
              "target": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{1,95}$"
              },
              "owner": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{1,63}$"
              },
              "telemetry_key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{1,95}$"
              },
              "removal_version": {
                "type": "string",
                "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)$"
              },
              "legacy_fixture": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
